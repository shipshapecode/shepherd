---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GithubButton from '../components/GithubButton.astro';
import { SITE_TITLE } from '../consts';

const { isHome } = Astro.props;

const brands: { name: string; src: string; href?: string }[] = [
  { name: 'Google', src: '/users/google.svg' },
  { name: 'Cisco', src: '/users/cisco.svg' },
  { name: 'Qualcomm', src: '/users/qualcomm.svg' },
  { name: 'Ubisoft', src: '/users/ubisoft.svg' },
  { name: 'Esri', src: '/users/esri.svg' },
  { name: 'ASSA ABLOY', src: '/users/assa-abloy.svg' },
  { name: 'Gallup', src: '/users/gallup.svg' },
  { name: 'Avalara', src: '/users/avalara.svg' },
  { name: 'Ally', src: '/users/ally.svg' },
  { name: 'CodePen', src: '/users/codepen.svg', href: 'https://codepen.io/pen/?welcome=true' }
];
---

<Base>
  <Header title={SITE_TITLE} isHome={isHome} />
  <main>
    <slot name='hero-heading' />

    <div class='flex justify-center w-full'>
      <div class='max-w-3xl text-center w-full'>
        <slot name='content' />
        <div class='hero-followup font-heading mb-12 mt-12 lg:mb-24 lg:mt-24'>
          <div class='bg-navy inline-block mb-4 w-56 lg:mr-4'>
            <GithubButton />
          </div>

          <div class='bg-navy inline-block mb-4 w-56'>
            <a
              class='button bg-white border-2 border-navy p-6 text-navy whitespace-nowrap w-full'
              href='https://docs.shepherdjs.dev'
            >
              View Docs
            </a>
          </div>
        </div>
      </div>
    </div>

    <section class='flex justify-center px-4 w-full'>
      <div class='max-w-6xl text-center w-full'>
        <h3 class='font-heading mb-6 text-2xl uppercase'>
          Brands that use Shepherd
        </h3>

        <ul class='flex flex-wrap justify-center w-full'>
          {
            brands.map(({ name, src, href }) => (
              <li class='h-24 m-3 relative w-40 md:m-4 md:w-48'>
                <div class='bg-white border-4 border-navy flex h-full items-center justify-center p-4 relative w-full z-10 md:p-6'>
                  {href ? (
                    <a class='flex h-full items-center justify-center w-full' href={href} target='_blank' rel='noopener'>
                      <img class='max-h-full max-w-full' src={src} alt={name} />
                    </a>
                  ) : (
                    <img class='max-h-full max-w-full' src={src} alt={name} />
                  )}
                </div>

                <div class='absolute bg-navy h-full -ml-2 mt-2 top-0 w-full z-0' />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
