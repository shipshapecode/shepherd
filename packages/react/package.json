{
  "name": "react-shepherd",
  "version": "8.0.0",
  "private": false,
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shipshapecode/shepherd.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "cp ../../LICENSE.md ./LICENSE.md && pnpm build",
    "test:ci": "vitest --run",
    "test:dev": "vitest"
  },
  "dependencies": {
    "shepherd.js": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": [
    "react",
    "react product tour",
    "react tour",
    "guided tour",
    "user onboarding",
    "onboarding",
    "walkthrough",
    "hooks",
    "shepherd",
    "shepherd.js"
  ]
}
